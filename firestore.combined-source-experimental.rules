rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() { return request.auth != null; }
    function member(conversationId) {
      return signedIn() && request.auth.uid in get(/databases/$(database)/documents/conversations/$(conversationId)).data.participants;
    }
    // A block in either direction prevents new interactions while preserving
    // each participant's access to existing history. Candidate only; see README.
    function pairUnblocked(participants) {
      return participants is list && participants.size() == 2
        && participants[0] is string && participants[1] is string
        && !exists(/databases/$(database)/documents/userBlocks/$(participants[0])/blocked/$(participants[1]))
        && !exists(/databases/$(database)/documents/userBlocks/$(participants[1])/blocked/$(participants[0]));
    }
    function conversationActive(conversationId) {
      return member(conversationId) && get(/databases/$(database)/documents/conversations/$(conversationId)).data.status == 'active'
        && pairUnblocked(get(/databases/$(database)/documents/conversations/$(conversationId)).data.participants);
    }
    // The list is private to its owner. Other users cannot read or change it;
    // rules can still consult it while checking messages and call signaling.
    match /userBlocks/{ownerId}/blocked/{blockedId} {
      allow read: if signedIn() && request.auth.uid == ownerId;
      allow create: if signedIn() && request.auth.uid == ownerId
        && blockedId != ownerId && blockedId.size() > 0 && blockedId.size() <= 128
        && request.resource.data.keys().hasOnly(['createdAt'])
        && request.resource.data.keys().hasAll(['createdAt'])
        && request.resource.data.createdAt == request.time;
      allow delete: if signedIn() && request.auth.uid == ownerId;
      allow update: if false;
    }

    // Experimental Spark-plan admin. Never deploy without official emulator,
    // two-account and security review. Exact email is a bootstrap constraint,
    // not client-side authorization; all accesses use server-verified tokens.
    function verifiedGoogle() {
      return signedIn() && request.auth.token.email_verified == true
        && request.auth.token.firebase.sign_in_provider == 'google.com'
        && request.auth.token.email is string;
    }
    function recentlyAuthenticated() {
      return verifiedGoogle() && request.auth.token.auth_time is int
        && request.auth.token.auth_time * 1000 <= request.time.toMillis() + 60000
        && request.auth.token.auth_time * 1000 >= request.time.toMillis() - 300000;
    }
    function sparkAdminPath() { return /databases/$(database)/documents/sparkAdmin/current; }
    function isSparkOwner() {
      return verifiedGoogle() && exists(sparkAdminPath())
        && get(sparkAdminPath()).data.uid == request.auth.uid;
    }
    function delegationPath(email) { return /databases/$(database)/documents/sparkDelegations/$(email); }
    function isSparkAdmin() {
      return isSparkOwner() || (verifiedGoogle() && exists(sparkAdminPath())
        && exists(delegationPath(request.auth.token.email))
        && get(delegationPath(request.auth.token.email)).data.status == 'active'
        && get(delegationPath(request.auth.token.email)).data.uid == request.auth.uid
        && get(delegationPath(request.auth.token.email)).data.invitedBy == get(sparkAdminPath()).data.uid);
    }
    function validPendingEmail(value) {
      return value is string && value.matches('^[a-z0-9][a-z0-9._%+-]{0,63}@gmail[.]com$');
    }
    match /sparkAdmin/current {
      allow get: if isSparkOwner();
      allow list, update, delete: if false;
      allow create: if recentlyAuthenticated() && request.auth.token.email == 'ishtiakahmedru@gmail.com'
        && request.resource.data.keys().hasAll(['uid', 'email', 'pendingEmail', 'createdAt', 'updatedAt'])
        && request.resource.data.keys().hasOnly(['uid', 'email', 'pendingEmail', 'createdAt', 'updatedAt'])
        && request.resource.data.uid == request.auth.uid
        && request.resource.data.email == request.auth.token.email
        && request.resource.data.pendingEmail == ''
        && request.resource.data.createdAt == request.time && request.resource.data.updatedAt == request.time;
    }
    // Only the original owner may invite or revoke delegates. Delegates can
    // change the bounded public setting but cannot grant further privileges.
    // This remains a review-only candidate: no immutable audit or recovery.
    match /sparkDelegations/{email} {
      allow get: if isSparkOwner() || (verifiedGoogle() && request.auth.token.email == email);
      allow list: if isSparkOwner();
      allow create: if isSparkOwner() && recentlyAuthenticated() && validPendingEmail(email)
        && email != get(sparkAdminPath()).data.email
        && request.resource.data.keys().hasAll(['email', 'uid', 'invitedBy', 'status', 'createdAt', 'updatedAt'])
        && request.resource.data.keys().hasOnly(['email', 'uid', 'invitedBy', 'status', 'createdAt', 'updatedAt'])
        && request.resource.data.email == email && request.resource.data.uid == ''
        && request.resource.data.invitedBy == request.auth.uid && request.resource.data.status == 'invited'
        && request.resource.data.createdAt == request.time && request.resource.data.updatedAt == request.time;
      allow update: if recentlyAuthenticated() && request.resource.data.updatedAt == request.time && (
        // Owner revokes an invitation or active delegation.
        (isSparkOwner() && resource.data.status in ['invited', 'active']
          && request.resource.data.status == 'revoked'
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status', 'updatedAt']))
        ||
        // Owner may explicitly re-invite a previously revoked address.
        (isSparkOwner() && resource.data.status == 'revoked'
          && request.resource.data.status == 'invited' && request.resource.data.uid == ''
          && request.resource.data.invitedBy == request.auth.uid
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status', 'uid', 'invitedBy', 'updatedAt']))
        ||
        // Only the verified Google account named in the invitation can accept.
        (resource.data.status == 'invited' && request.auth.token.email == email
          && request.resource.data.status == 'active' && request.resource.data.uid == request.auth.uid
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status', 'uid', 'updatedAt']))
      );
      allow delete: if false;
    }
    match /settings/sparkPublic {
      allow get: if true;
      allow list, delete: if false;
      allow create, update: if isSparkAdmin() && recentlyAuthenticated()
        && request.resource.data.keys().hasAll(['welcome', 'updatedAt', 'updatedBy'])
        && request.resource.data.keys().hasOnly(['welcome', 'updatedAt', 'updatedBy'])
        && request.resource.data.welcome is string && request.resource.data.welcome.size() > 0
        && request.resource.data.welcome.size() <= 160
        && request.resource.data.updatedAt == request.time
        && request.resource.data.updatedBy == request.auth.uid;
    }

    // Review-only bounded appearance options; no arbitrary CSS or code.
    match /settings/{appearance} {
      allow get: if appearance in ['sparkTheme', 'sparkMenu'];
      allow create, update: if appearance in ['sparkTheme', 'sparkMenu']
        && isSparkAdmin() && recentlyAuthenticated()
        && request.resource.data.keys().hasAll(['value', 'updatedAt', 'updatedBy'])
        && request.resource.data.keys().hasOnly(['value', 'updatedAt', 'updatedBy'])
        && ((appearance == 'sparkTheme' && request.resource.data.value in ['default', 'lavender'])
          || (appearance == 'sparkMenu' && request.resource.data.value in ['bottom', 'top']))
        && request.resource.data.updatedAt == request.time
        && request.resource.data.updatedBy == request.auth.uid;
      allow list, delete: if false;
    }

    // Review-only source handover; trusted server provisioning only.
    match /sparkPrivate/sourceHandover {
      allow get: if isSparkAdmin();
      allow list, create, update, delete: if false;
    }

    // Public display settings can only be changed by the trusted backend.
    match /settings/public {
      allow get: if true;
      allow list, write: if false;
    }
    match /profiles/{uid} {
      // Direct lookup by UID only; directory listing and email collection are prohibited.
      allow get: if signedIn();
      allow list: if false;
      allow create, update: if signedIn() && request.auth.uid == uid
        && request.resource.data.keys().hasAll(['uid', 'displayName'])
        && request.resource.data.keys().hasOnly(['uid', 'displayName'])
        && request.resource.data.uid == uid
        && request.resource.data.displayName is string
        && request.resource.data.displayName.size() > 0
        && request.resource.data.displayName.size() <= 80;
      allow delete: if false;
    }
    match /conversations/{conversationId} {
      allow read: if signedIn() && request.auth.uid in resource.data.participants;
      allow create: if signedIn()
        && request.resource.data.keys().hasAll(['participants', 'createdBy', 'createdAt', 'status', 'updatedAt'])
        && request.resource.data.keys().hasOnly(['participants', 'createdBy', 'createdAt', 'status', 'updatedAt'])
        && request.resource.data.participants is list
        && request.resource.data.participants.size() == 2
        && request.resource.data.participants[0] is string
        && request.resource.data.participants[1] is string
        && request.resource.data.participants[0] != request.resource.data.participants[1]
        && request.auth.uid in request.resource.data.participants
        && request.resource.data.createdBy == request.auth.uid
        && request.resource.data.createdAt == request.time
        && request.resource.data.updatedAt == request.time && request.resource.data.status == 'pending'
        && pairUnblocked(request.resource.data.participants)
        && exists(/databases/$(database)/documents/profiles/$(request.resource.data.participants[0]))
        && exists(/databases/$(database)/documents/profiles/$(request.resource.data.participants[1]));
      // Recipient alone can accept; either member may cancel a pending
      // request or close an active chat. A separate block can prevent new interactions.
      allow update: if signedIn() && request.auth.uid in resource.data.participants
        && request.resource.data.updatedAt == request.time
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status', 'updatedAt'])
        && (
          (resource.data.status == 'pending' && request.resource.data.status == 'active'
            && pairUnblocked(resource.data.participants) && request.auth.uid != resource.data.createdBy)
          || (resource.data.status in ['pending', 'active'] && request.resource.data.status == 'closed')
        );
      allow delete: if false;
      // Experimental call signaling; deliberately not selected by firebase.json.
      // Requires rate limits, retention cleanup, real-device tests and review.
      match /calls/{callId} {
        function validDescription(value, kind) {
          return value is map && value.keys().hasAll(['type', 'sdp'])
            && value.keys().hasOnly(['type', 'sdp']) && value.type == kind
            && value.sdp is string && value.sdp.size() > 0 && value.sdp.size() <= 65536;
        }
        function callPath() { return /databases/$(database)/documents/conversations/$(conversationId)/calls/$(callId); }
        function callData() { return get(callPath()).data; }
        function active() { return request.time < callData().createdAt + duration.value(5, 'm'); }
        function validCandidate(data) {
          return data.keys().hasAll(['candidate', 'sdpMid', 'sdpMLineIndex', 'createdAt'])
            && data.keys().hasOnly(['candidate', 'sdpMid', 'sdpMLineIndex', 'createdAt'])
            && data.candidate is string && data.candidate.size() > 0 && data.candidate.size() <= 4096
            && (data.sdpMid == null || (data.sdpMid is string && data.sdpMid.size() <= 256))
            && (data.sdpMLineIndex == null || (data.sdpMLineIndex is int && data.sdpMLineIndex >= 0 && data.sdpMLineIndex <= 65535))
            && data.createdAt == request.time;
        }
        allow read: if member(conversationId);
        allow create: if conversationActive(conversationId)
          && request.resource.data.keys().hasAll(['callerId', 'receiverId', 'media', 'offer', 'status', 'createdAt', 'updatedAt'])
          && request.resource.data.keys().hasOnly(['callerId', 'receiverId', 'media', 'offer', 'status', 'createdAt', 'updatedAt'])
          && request.resource.data.callerId == request.auth.uid
          && request.resource.data.receiverId is string
          && request.resource.data.receiverId != request.auth.uid
          && request.resource.data.receiverId in get(/databases/$(database)/documents/conversations/$(conversationId)).data.participants
          && request.resource.data.media in ['audio', 'video']
          && validDescription(request.resource.data.offer, 'offer')
          && request.resource.data.status == 'ringing'
          && request.resource.data.createdAt == request.time && request.resource.data.updatedAt == request.time;
        // Expiry bounds new signaling, not the ability to end a call. Either
        // participant must still be able to notify the other after five minutes.
        allow update: if member(conversationId)
          && request.resource.data.updatedAt == request.time
          && (
            (request.time < resource.data.createdAt + duration.value(5, 'm')
              && conversationActive(conversationId) && request.auth.uid == resource.data.receiverId && resource.data.status == 'ringing'
              && request.resource.data.status == 'accepted'
              && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status', 'answer', 'updatedAt'])
              && validDescription(request.resource.data.answer, 'answer'))
            ||
            ((request.auth.uid == resource.data.callerId || request.auth.uid == resource.data.receiverId)
              && resource.data.status in ['ringing', 'accepted'] && request.resource.data.status == 'ended'
              && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status', 'updatedAt']))
          );
        allow delete: if false;
        match /callerCandidates/{candidateId} {
          allow read: if member(conversationId);
          allow create: if conversationActive(conversationId) && request.auth.uid == callData().callerId && active()
            && callData().status in ['ringing', 'accepted'] && validCandidate(request.resource.data);
          allow update, delete: if false;
        }
        match /receiverCandidates/{candidateId} {
          allow read: if member(conversationId);
          allow create: if conversationActive(conversationId) && request.auth.uid == callData().receiverId && active()
            && callData().status == 'accepted' && validCandidate(request.resource.data);
          allow update, delete: if false;
        }
      }
      match /messages/{messageId} {
        allow read: if member(conversationId);
        allow create: if conversationActive(conversationId)
          && request.resource.data.keys().hasAll(['senderId', 'body', 'sentAt'])
          && request.resource.data.keys().hasOnly(['senderId', 'body', 'sentAt'])
          && request.resource.data.senderId == request.auth.uid
          && request.resource.data.body is string
          && request.resource.data.body.size() > 0
          && request.resource.data.body.size() <= 2000
          && request.resource.data.sentAt == request.time;
        allow update, delete: if false;
      }
    }
  }
}
