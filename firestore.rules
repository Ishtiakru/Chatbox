rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    match /{document=**} {
      allow read, write: if false;
    }

    // Mobile number + password accounts sign in with a private per-number
    // address (<digits>@phone.chatbox.app); Firebase keeps it unique per number.
    function isPhonePasswordUser() {
      return 'email' in request.auth.token
        && request.auth.token.email is string
        && request.auth.token.email.matches('^[0-9]{7,15}@phone[.]chatbox[.]app$');
    }

    function isSignedIn() {
      return request.auth != null && (
        ('email_verified' in request.auth.token && request.auth.token.email_verified == true)
        || request.auth.token.firebase.sign_in_provider == 'phone'
        || isPhonePasswordUser()
      );
    }

    // Users may only claim their own number: the SMS-verified one, or the number
    // their phone+password account was created with.
    function ownsPhoneKey(phoneKey) {
      return ('phone_number' in request.auth.token)
        ? request.auth.token.phone_number == '+' + phoneKey
        : (isPhonePasswordUser()
            ? (request.auth.token.email == phoneKey + '@phone.chatbox.app'
               || request.auth.token.email == '88' + phoneKey + '@phone.chatbox.app')
            : true);
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    function isValidId(id) {
      return id is string && id.size() > 0 && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function isValidShortId(shortId) {
      return shortId is string && shortId.size() == 6 && shortId.matches('^[0-9]{6}$');
    }

    function isValidPhoneKey(phoneKey) {
      return phoneKey is string && phoneKey.size() >= 7 && phoneKey.size() <= 15 && phoneKey.matches('^[0-9]{7,15}$');
    }

    function member(conversationId) {
      return isSignedIn()
        && exists(/databases/$(database)/documents/conversations/$(conversationId))
        && request.auth.uid in get(/databases/$(database)/documents/conversations/$(conversationId)).data.participants;
    }

    function pairUnblocked(participants) {
      return participants is list && participants.size() == 2
        && participants[0] is string && participants[1] is string
        && !exists(/databases/$(database)/documents/userBlocks/$(participants[0])/blocked/$(participants[1]))
        && !exists(/databases/$(database)/documents/userBlocks/$(participants[1])/blocked/$(participants[0]));
    }

    function conversationActive(conversationId) {
      return member(conversationId)
        && get(/databases/$(database)/documents/conversations/$(conversationId)).data.status in ['pending', 'active']
        && pairUnblocked(get(/databases/$(database)/documents/conversations/$(conversationId)).data.participants);
    }

    function isValidUserBlock(data) {
      return data.keys().hasAll(['createdAt'])
        && data.keys().hasOnly(['createdAt'])
        && data.createdAt is timestamp
        && data.createdAt <= request.time;
    }

    function isValidFcmDevice(data) {
      return data.keys().hasAll(['token', 'platform', 'updatedAt'])
        && data.keys().hasOnly(['token', 'platform', 'updatedAt'])
        && data.token is string
        && data.token.size() > 0
        && data.token.size() <= 512
        && data.platform in ['android', 'web']
        && data.updatedAt is timestamp
        && data.updatedAt <= request.time;
    }

    function isValidProfile(data, uid) {
      return data.keys().hasAll(['uid', 'displayName'])
        && data.keys().hasOnly(['uid', 'displayName', 'shortId', 'about', 'photoUrl'])
        && data.uid is string
        && data.uid == uid
        && data.uid.size() > 0
        && data.uid.size() <= 128
        && data.displayName is string
        && data.displayName.size() > 0
        && data.displayName.size() <= 80
        && (!('shortId' in data) || isValidShortId(data.shortId))
        && (!('about' in data) || (data.about is string && data.about.size() <= 140))
        && (!('photoUrl' in data) || (data.photoUrl is string && data.photoUrl.size() <= 500
          && data.photoUrl.matches('https://.+')));
    }

    function isValidDirectoryEntry(data) {
      return data.keys().hasAll(['uid', 'displayName'])
        && data.keys().hasOnly(['uid', 'displayName'])
        && data.uid is string
        && data.uid == request.auth.uid
        && data.uid.size() > 0
        && data.uid.size() <= 128
        && data.displayName is string
        && data.displayName.size() > 0
        && data.displayName.size() <= 80;
    }

    function isValidPrivateProfile(data) {
      return data.keys().hasAll(['phoneNumber', 'updatedAt'])
        && data.keys().hasOnly(['phoneNumber', 'updatedAt'])
        && data.phoneNumber is string
        && data.phoneNumber.size() <= 24
        && data.updatedAt is timestamp
        && data.updatedAt <= request.time;
    }

    function isValidConversation(data) {
      return data.keys().hasAll(['participants', 'createdBy', 'createdAt', 'status', 'updatedAt'])
        && data.keys().hasOnly(['participants', 'createdBy', 'createdAt', 'status', 'updatedAt', 'seen'])
        && data.participants is list
        && data.participants.size() == 2
        && data.participants[0] is string && data.participants[0].size() > 0 && data.participants[0].size() <= 128
        && data.participants[1] is string && data.participants[1].size() > 0 && data.participants[1].size() <= 128
        && data.participants[0] != data.participants[1]
        && data.createdBy is string && data.createdBy.size() > 0 && data.createdBy.size() <= 128
        && data.status in ['pending', 'active', 'closed']
        && data.createdAt is timestamp && data.createdAt <= request.time
        && data.updatedAt is timestamp && data.updatedAt <= request.time;
    }

    function isValidOptionalImageUrl(data) {
      return !('imageUrl' in data) || (
        data.imageUrl is string
        && data.imageUrl.size() > 0
        && data.imageUrl.size() <= 2048
        && data.imageUrl.matches('^https://.*')
      );
    }

    function isValidOptionalAudioUrl(data) {
      return !('audioUrl' in data) || (
        data.audioUrl is string
        && data.audioUrl.size() > 0
        && data.audioUrl.size() <= 2048
        && data.audioUrl.matches('^https://.*')
      );
    }

    function isValidOptionalAudioDuration(data) {
      return !('audioDurationMs' in data) || (
        ('audioUrl' in data && data.audioUrl is string && data.audioUrl.size() > 0 && data.audioUrl.size() <= 2048)
        && data.audioDurationMs is int
        && data.audioDurationMs >= 0
        && data.audioDurationMs <= 300000
      );
    }

    function isValidOptionalVideoUrl(data) {
      return !('videoUrl' in data) || (
        ('videoUrl' in data && data.videoUrl is string && data.videoUrl.size() > 0 && data.videoUrl.size() <= 2048
          && data.videoUrl.matches('^https://.*'))
      );
    }

    function isValidMessage(data) {
      return data.keys().hasAll(['senderId', 'body', 'sentAt'])
        && data.keys().hasOnly(['senderId', 'body', 'sentAt', 'imageUrl', 'audioUrl', 'audioDurationMs', 'videoUrl'])
        && data.senderId is string && data.senderId.size() > 0 && data.senderId.size() <= 128
        && data.body is string && data.body.size() <= 2000
        && isValidOptionalImageUrl(data)
        && isValidOptionalAudioUrl(data)
        && isValidOptionalAudioDuration(data)
        && isValidOptionalVideoUrl(data)
        && (
          data.body.size() > 0
          || ('imageUrl' in data && data.imageUrl is string && data.imageUrl.size() > 0)
          || ('audioUrl' in data && data.audioUrl is string && data.audioUrl.size() > 0)
          || ('videoUrl' in data && data.videoUrl is string && data.videoUrl.size() > 0)
        )
        && data.sentAt is timestamp && data.sentAt <= request.time;
    }

    function verifiedGoogle() {
      return isSignedIn()
        && request.auth.token.firebase.sign_in_provider == 'google.com'
        && request.auth.token.email is string
        && request.auth.token.email.size() > 0
        && request.auth.token.email.size() <= 128;
    }

    // A real login: Google, or mobile number + password (both bound to the uid).
    function verifiedLogin() {
      return verifiedGoogle() || (isSignedIn() && isPhonePasswordUser());
    }

    function recentlyAuthenticated() {
      return verifiedLogin()
        && request.auth.token.auth_time is int
        && request.auth.token.auth_time * 1000 <= request.time.toMillis() + 60000
        && request.auth.token.auth_time * 1000 >= request.time.toMillis() - 300000;
    }

    function sparkAdminPath() {
      return /databases/$(database)/documents/sparkAdmin/current;
    }

    function isSparkOwner() {
      return verifiedLogin()
        && exists(sparkAdminPath())
        && get(sparkAdminPath()).data.uid == request.auth.uid;
    }

    function delegationPath(email) {
      return /databases/$(database)/documents/sparkDelegations/$(email);
    }

    function isSparkAdmin() {
      return isSparkOwner() || (
        verifiedGoogle()
        && exists(sparkAdminPath())
        && exists(delegationPath(request.auth.token.email))
        && get(delegationPath(request.auth.token.email)).data.status == 'active'
        && get(delegationPath(request.auth.token.email)).data.uid == request.auth.uid
        && get(delegationPath(request.auth.token.email)).data.invitedBy == get(sparkAdminPath()).data.uid
      );
    }

    function validPendingEmail(value) {
      return value is string && value.size() > 0 && value.size() <= 128 && value.matches('^[a-z0-9][a-z0-9._%+-]{0,63}@gmail[.]com$');
    }

    function isValidSparkAdmin(data) {
      return data.keys().hasAll(['uid', 'email', 'pendingEmail', 'createdAt', 'updatedAt'])
        && data.keys().hasOnly(['uid', 'email', 'pendingEmail', 'createdAt', 'updatedAt'])
        && data.uid is string && data.uid.size() > 0 && data.uid.size() <= 128
        && data.email is string && data.email.size() > 0 && data.email.size() <= 128
        && data.pendingEmail is string && data.pendingEmail == ''
        && data.createdAt is timestamp && data.createdAt <= request.time
        && data.updatedAt is timestamp && data.updatedAt <= request.time;
    }

    function isValidSparkDelegation(data) {
      return data.keys().hasAll(['email', 'uid', 'invitedBy', 'status', 'createdAt', 'updatedAt'])
        && data.keys().hasOnly(['email', 'uid', 'invitedBy', 'status', 'createdAt', 'updatedAt'])
        && validPendingEmail(data.email)
        && data.uid is string && data.uid.size() <= 128
        && data.invitedBy is string && data.invitedBy.size() > 0 && data.invitedBy.size() <= 128
        && data.status in ['invited', 'active', 'revoked']
        && data.createdAt is timestamp && data.createdAt <= request.time
        && data.updatedAt is timestamp && data.updatedAt <= request.time;
    }

    function isValidSparkPublic(data) {
      return data.keys().hasAll(['welcome', 'updatedAt', 'updatedBy'])
        && data.keys().hasOnly(['welcome', 'updatedAt', 'updatedBy'])
        && data.welcome is string && data.welcome.size() > 0 && data.welcome.size() <= 160
        && data.updatedBy is string && data.updatedBy.size() > 0 && data.updatedBy.size() <= 128
        && data.updatedAt is timestamp && data.updatedAt <= request.time;
    }

    function isValidSparkAppearance(appearance, data) {
      return data.keys().hasAll(['value', 'updatedAt', 'updatedBy'])
        && data.keys().hasOnly(['value', 'updatedAt', 'updatedBy'])
        && ((appearance == 'sparkTheme' && data.value in ['default', 'lavender'])
          || (appearance == 'sparkMenu' && data.value in ['bottom', 'top']))
        && data.updatedBy is string && data.updatedBy.size() > 0 && data.updatedBy.size() <= 128
        && data.updatedAt is timestamp && data.updatedAt <= request.time;
    }

    function isValidCustomMenuItem(item) {
      return item is map
        && item.keys().hasAll(['id', 'label', 'icon', 'title', 'body'])
        && item.keys().hasOnly(['id', 'label', 'icon', 'title', 'body'])
        && item.id is string && item.id.size() > 0 && item.id.size() <= 32
        && item.label is string && item.label.size() > 0 && item.label.size() <= 24
        && item.icon is string && item.icon in ['sparkles', 'bell', 'megaphone', 'book', 'star', 'info', 'grid']
        && item.title is string && item.title.size() > 0 && item.title.size() <= 80
        && item.body is string && item.body.size() > 0 && item.body.size() <= 1000;
    }

    function isValidSparkDynamicConfig(data) {
      return data.keys().hasAll(['appTitle', 'homeAnnouncement', 'customMenus', 'updatedBy', 'updatedAt'])
        && data.keys().hasOnly(['appTitle', 'homeAnnouncement', 'customMenus', 'updatedBy', 'updatedAt'])
        && data.appTitle is string && data.appTitle.size() > 0 && data.appTitle.size() <= 40
        && data.homeAnnouncement is string && data.homeAnnouncement.size() <= 240
        && data.customMenus is list && data.customMenus.size() <= 5
        && (data.customMenus.size() < 1 || isValidCustomMenuItem(data.customMenus[0]))
        && (data.customMenus.size() < 2 || isValidCustomMenuItem(data.customMenus[1]))
        && (data.customMenus.size() < 3 || isValidCustomMenuItem(data.customMenus[2]))
        && (data.customMenus.size() < 4 || isValidCustomMenuItem(data.customMenus[3]))
        && (data.customMenus.size() < 5 || isValidCustomMenuItem(data.customMenus[4]))
        && data.updatedBy is string && data.updatedBy.size() > 0 && data.updatedBy.size() <= 128
        && data.updatedAt is timestamp && data.updatedAt <= request.time;
    }

    function isValidSparkUpdate(data) {
      return data.keys().hasAll(['active', 'version', 'note', 'downloadUrl', 'updatedAt', 'updatedBy'])
        && data.keys().hasOnly(['active', 'version', 'note', 'downloadUrl', 'updatedAt', 'updatedBy'])
        && data.active is bool
        && data.version is string && data.version.size() <= 32 && (!data.active || data.version.size() > 0)
        && data.note is string && data.note.size() <= 240
        && data.downloadUrl is string && data.downloadUrl.size() <= 512
        && (data.downloadUrl == '' || data.downloadUrl.matches('^https://.*'))
        && data.updatedBy is string && data.updatedBy.size() > 0 && data.updatedBy.size() <= 128
        && data.updatedAt is timestamp && data.updatedAt <= request.time;
    }

    function isValidSairaSession(data) {
      return data.keys().hasAll(['title', 'lastPreview', 'exchangeCount', 'createdAt', 'updatedAt'])
        && data.keys().hasOnly(['title', 'lastPreview', 'exchangeCount', 'createdAt', 'updatedAt'])
        && data.title is string && data.title.size() > 0 && data.title.size() <= 120
        && data.lastPreview is string && data.lastPreview.size() <= 240
        && data.exchangeCount is int && data.exchangeCount >= 0 && data.exchangeCount <= 5000
        && data.createdAt is timestamp && data.createdAt <= request.time
        && data.updatedAt is timestamp && data.updatedAt <= request.time;
    }

    function isValidSairaExchange(data) {
      return data.keys().hasAll(['question', 'answer', 'sequence', 'createdAt'])
        && data.keys().hasOnly(['question', 'answer', 'sequence', 'createdAt'])
        && data.question is string && data.question.size() > 0 && data.question.size() <= 2000
        && data.answer is string && data.answer.size() > 0 && data.answer.size() <= 12000
        && data.sequence is int && data.sequence >= 0 && data.sequence <= 100000
        && data.createdAt is timestamp && data.createdAt <= request.time;
    }

    match /profiles/{uid} {
      allow get: if isSignedIn() && isValidId(uid);
      allow list: if false;
      allow create: if isSignedIn()
        && isValidId(uid)
        && request.auth.uid == uid
        && isValidProfile(incoming(), uid);
      allow update: if isSignedIn()
        && isValidId(uid)
        && request.auth.uid == uid
        && isValidProfile(incoming(), uid)
        && incoming().uid == existing().uid
        && incoming().diff(existing()).affectedKeys().hasOnly(['displayName', 'shortId', 'about', 'photoUrl']);
      allow delete: if false;
    }

    match /shortIds/{shortId} {
      allow get: if isSignedIn() && isValidShortId(shortId);
      allow list: if false;
      allow create: if isSignedIn()
        && isValidShortId(shortId)
        && isValidDirectoryEntry(incoming());
      allow update: if isSignedIn()
        && isValidShortId(shortId)
        && isValidDirectoryEntry(incoming())
        && existing().uid == request.auth.uid
        && incoming().uid == existing().uid
        && incoming().diff(existing()).affectedKeys().hasOnly(['displayName']);
      allow delete: if isSignedIn() && isValidShortId(shortId) && existing().uid == request.auth.uid;
    }

    match /phoneDirectory/{phoneKey} {
      allow get: if isSignedIn() && isValidPhoneKey(phoneKey);
      allow list: if false;
      allow create: if isSignedIn()
        && isValidPhoneKey(phoneKey)
        && ownsPhoneKey(phoneKey)
        && isValidDirectoryEntry(incoming());
      allow update: if isSignedIn()
        && isValidPhoneKey(phoneKey)
        && isValidDirectoryEntry(incoming())
        && existing().uid == request.auth.uid
        && incoming().uid == existing().uid
        && incoming().diff(existing()).affectedKeys().hasOnly(['displayName']);
      allow delete: if isSignedIn() && isValidPhoneKey(phoneKey) && existing().uid == request.auth.uid;
    }

    // ---- Gmails added to a number account (any number of them) ----
    function validRecoveryGmail(value) {
      return value is string && value.size() > 0 && value.size() <= 128
        && value.matches('^[a-z0-9][a-z0-9._%+-]{0,63}@gmail[.]com$');
    }

    function signedInAsGmail(email) {
      return request.auth != null
        && 'email' in request.auth.token
        && request.auth.token.email == email
        && 'email_verified' in request.auth.token
        && request.auth.token.email_verified == true;
    }

    match /users/{userId}/private/recovery {
      allow get: if isSignedIn() && isValidId(userId) && request.auth.uid == userId;
      allow create, update: if isSignedIn()
        && isValidId(userId)
        && request.auth.uid == userId
        && incoming().keys().hasAll(['emails', 'updatedAt'])
        && incoming().keys().hasOnly(['emails', 'updatedAt'])
        && incoming().emails is list
        && incoming().emails.size() <= 500
        && incoming().updatedAt == request.time;
      allow list, delete: if false;
    }

    match /gmailRecovery/{email}/accounts/{userId} {
      // Readable only by someone who proved they own this Gmail.
      allow get, list: if validRecoveryGmail(email) && signedInAsGmail(email);
      allow create, update: if isSignedIn()
        && isPhonePasswordUser()
        && isValidId(userId)
        && request.auth.uid == userId
        && validRecoveryGmail(email)
        && incoming().keys().hasAll(['login', 'secret', 'updatedAt'])
        && incoming().keys().hasOnly(['login', 'secret', 'updatedAt'])
        && incoming().login == request.auth.token.email
        && incoming().secret is string
        && incoming().secret.size() > 0
        && incoming().secret.size() <= 1024
        && incoming().updatedAt == request.time;
      allow delete: if request.auth != null
        && (request.auth.uid == userId || signedInAsGmail(email));
    }

    match /users/{userId}/private/profile {
      allow get: if isSignedIn() && isValidId(userId) && request.auth.uid == userId;
      allow create: if isSignedIn()
        && isValidId(userId)
        && request.auth.uid == userId
        && isValidPrivateProfile(incoming());
      allow update: if isSignedIn()
        && isValidId(userId)
        && request.auth.uid == userId
        && isValidPrivateProfile(incoming())
        && incoming().diff(existing()).affectedKeys().hasOnly(['phoneNumber', 'updatedAt']);
      allow list, delete: if false;
    }

    match /userBlocks/{ownerId}/blocked/{blockedId} {
      allow get: if isSignedIn() && isValidId(ownerId) && isValidId(blockedId) && request.auth.uid == ownerId;
      allow list: if isSignedIn() && isValidId(ownerId) && request.auth.uid == ownerId;
      allow create: if isSignedIn()
        && isValidId(ownerId)
        && isValidId(blockedId)
        && request.auth.uid == ownerId
        && blockedId != ownerId
        && isValidUserBlock(incoming());
      allow delete: if isSignedIn() && isValidId(ownerId) && isValidId(blockedId) && request.auth.uid == ownerId;
      allow update: if false;
    }

    match /userFcmTokens/{ownerId}/devices/{deviceId} {
      allow get: if isSignedIn()
        && isValidId(ownerId)
        && isValidId(deviceId)
        && request.auth.uid == ownerId;
      allow list: if isSignedIn()
        && isValidId(ownerId)
        && request.auth.uid == ownerId;
      allow create, update: if isSignedIn()
        && isValidId(ownerId)
        && isValidId(deviceId)
        && request.auth.uid == ownerId
        && isValidFcmDevice(incoming());
      allow delete: if isSignedIn()
        && isValidId(ownerId)
        && isValidId(deviceId)
        && request.auth.uid == ownerId;
    }

    match /conversations/{conversationId} {
      allow get: if isSignedIn() && isValidId(conversationId)
        && (resource == null || request.auth.uid in existing().participants);
      allow list: if isSignedIn() && request.auth.uid in existing().participants;
      allow create: if isSignedIn()
        && isValidId(conversationId)
        && isValidConversation(incoming())
        && incoming().createdAt <= request.time
        && request.auth.uid in incoming().participants
        && incoming().createdBy == request.auth.uid
        && incoming().status == 'pending'
        && pairUnblocked(incoming().participants)
        && exists(/databases/$(database)/documents/profiles/$(incoming().participants[0]))
        && exists(/databases/$(database)/documents/profiles/$(incoming().participants[1]));
      allow update: if isSignedIn()
        && isValidId(conversationId)
        && isValidConversation(incoming())
        && request.auth.uid in existing().participants
        && incoming().participants == existing().participants
        && incoming().createdBy == existing().createdBy
        && incoming().createdAt == existing().createdAt
        && incoming().diff(existing()).affectedKeys().hasOnly(['status', 'updatedAt'])
        && (
          (existing().status == 'pending' && incoming().status == 'active'
            && pairUnblocked(existing().participants) && request.auth.uid != existing().createdBy)
          || (existing().status in ['pending', 'active'] && incoming().status == 'closed')
        );
      // Read receipts: a participant may only set their own entry of the `seen` map.
      allow update: if isSignedIn()
        && isValidId(conversationId)
        && request.auth.uid in existing().participants
        && incoming().diff(existing()).affectedKeys().hasOnly(['seen'])
        && incoming().seen is map
        && incoming().seen.diff(existing().get('seen', {})).affectedKeys().hasOnly([request.auth.uid])
        && incoming().seen[request.auth.uid] is string
        && incoming().seen[request.auth.uid].size() <= 150;
      allow delete: if false;

      match /messages/{messageId} {
        allow get: if isValidId(conversationId) && isValidId(messageId) && member(conversationId);
        allow list: if isValidId(conversationId) && member(conversationId);
        allow create: if isValidId(conversationId)
          && isValidId(messageId)
          && isValidMessage(incoming())
          && incoming().senderId == request.auth.uid
          && conversationActive(conversationId);
        allow update, delete: if false;
      }
    }

    match /users/{userId}/sairaSessions/{sessionId} {
      allow get: if isSignedIn()
        && isValidId(userId)
        && isValidId(sessionId)
        && request.auth.uid == userId;
      allow list: if isSignedIn()
        && isValidId(userId)
        && request.auth.uid == userId;
      allow create: if isSignedIn()
        && isValidId(userId)
        && isValidId(sessionId)
        && request.auth.uid == userId
        && isValidSairaSession(incoming())
        && incoming().createdAt <= request.time;
      allow update: if isSignedIn()
        && isValidId(userId)
        && isValidId(sessionId)
        && request.auth.uid == userId
        && isValidSairaSession(incoming())
        && incoming().createdAt == existing().createdAt
        && incoming().diff(existing()).affectedKeys().hasOnly(['title', 'lastPreview', 'exchangeCount', 'updatedAt']);
      allow delete: if isSignedIn()
        && isValidId(userId)
        && isValidId(sessionId)
        && request.auth.uid == userId;

      match /exchanges/{exchangeId} {
        allow get: if isSignedIn()
          && isValidId(userId)
          && isValidId(sessionId)
          && isValidId(exchangeId)
          && request.auth.uid == userId;
        allow list: if isSignedIn()
          && isValidId(userId)
          && isValidId(sessionId)
          && request.auth.uid == userId;
        allow create: if isSignedIn()
          && isValidId(userId)
          && isValidId(sessionId)
          && isValidId(exchangeId)
          && request.auth.uid == userId
          && isValidSairaExchange(incoming())
          && (
            exists(/databases/$(database)/documents/users/$(userId)/sairaSessions/$(sessionId))
            || existsAfter(/databases/$(database)/documents/users/$(userId)/sairaSessions/$(sessionId))
          );
        allow update: if false;
        allow delete: if isSignedIn()
          && isValidId(userId)
          && isValidId(sessionId)
          && isValidId(exchangeId)
          && request.auth.uid == userId;
      }
    }

    match /sparkAdmin/current {
      allow get: if isSparkOwner();
      allow list, delete: if false;
      allow create, update: if recentlyAuthenticated()
        && request.auth.token.email in ['sojibsheikhuk@gmail.com']
        && isValidSparkAdmin(incoming())
        && incoming().uid == request.auth.uid
        && incoming().email == request.auth.token.email;
    }

    match /sparkDelegations/{email} {
      allow get: if isSparkOwner() || (verifiedGoogle() && request.auth.token.email == email);
      allow list: if isSparkOwner();
      allow create: if isSparkOwner()
        && recentlyAuthenticated()
        && validPendingEmail(email)
        && isValidSparkDelegation(incoming())
        && incoming().createdAt <= request.time
        && email != get(sparkAdminPath()).data.email
        && incoming().email == email
        && incoming().uid == ''
        && incoming().invitedBy == request.auth.uid
        && incoming().status == 'invited';
      allow update: if recentlyAuthenticated()
        && isValidSparkDelegation(incoming())
        && incoming().email == existing().email
        && incoming().createdAt == existing().createdAt
        && (
          (isSparkOwner() && existing().status in ['invited', 'active']
            && incoming().status == 'revoked'
            && incoming().diff(existing()).affectedKeys().hasOnly(['status', 'updatedAt']))
          ||
          (isSparkOwner() && existing().status == 'revoked'
            && incoming().status == 'invited' && incoming().uid == ''
            && incoming().invitedBy == request.auth.uid
            && incoming().diff(existing()).affectedKeys().hasOnly(['status', 'uid', 'invitedBy', 'updatedAt']))
          ||
          (existing().status == 'invited' && request.auth.token.email == email
            && incoming().status == 'active' && incoming().uid == request.auth.uid
            && incoming().diff(existing()).affectedKeys().hasOnly(['status', 'uid', 'updatedAt']))
        );
      allow delete: if false;
    }

    match /settings/sparkPublic {
      allow get: if isSignedIn();
      allow list, delete: if false;
      allow create, update: if isSparkAdmin()
        && recentlyAuthenticated()
        && isValidSparkPublic(incoming())
        && incoming().updatedBy == request.auth.uid;
    }

    match /settings/sparkConfig {
      allow get: if isSignedIn();
      allow list, delete: if false;
      allow create: if isSparkAdmin()
        && recentlyAuthenticated()
        && isValidSparkDynamicConfig(incoming())
        && incoming().updatedBy == request.auth.uid;
      allow update: if isSparkAdmin()
        && recentlyAuthenticated()
        && isValidSparkDynamicConfig(incoming())
        && incoming().updatedBy == request.auth.uid
        && incoming().diff(existing()).affectedKeys().hasOnly(['appTitle', 'homeAnnouncement', 'customMenus', 'updatedBy', 'updatedAt']);
    }

    match /settings/sparkUpdate {
      allow get: if isSignedIn();
      allow create, update: if isSparkAdmin()
        && recentlyAuthenticated()
        && isValidSparkUpdate(incoming())
        && incoming().updatedBy == request.auth.uid;
      allow list, delete: if false;
    }

    // The app owner (or the Spark admin) may hand Saira new AI keys from the app.
    function isKeyManager() {
      return isSignedIn()
        && (request.auth.uid == 'OtcWI8ox8XYQWTKOXicJzrcacai2' || isSparkAdmin());
    }

    // Gemini API key pool (GeminiKeyPool.kt). Written by the CI service account
    // (sync-keypool.yml / add-keys.yml, bypasses rules) or by the owner when he
    // sends Saira new keys in the app — the pool can only grow that way. Any
    // signed-in app user may read it so Saira can rotate through the pool.
    match /settings/aiKeyPool {
      allow get: if isSignedIn();
      allow update: if isKeyManager()
        && incoming().diff(existing()).affectedKeys().hasOnly(['keys', 'count', 'updatedAt', 'updatedBy'])
        && incoming()['keys'] is list
        && incoming()['keys'].size() <= 2000
        && incoming()['keys'].size() >= existing()['keys'].size()
        && incoming()['updatedBy'] == request.auth.uid;
      allow list, create, delete: if false;
    }

    // Owner-only vault: the owner's own paid AI keys (Claude / GPT …) that power
    // Saira's coding agent on GitHub (read there with the service account).
    match /adminVault/{docId} {
      allow get: if isKeyManager() && docId == 'sairaProKeys';
      allow create, update: if isKeyManager() && docId == 'sairaProKeys'
        && incoming().keys().hasOnly(['keys', 'updatedAt', 'updatedBy'])
        && incoming()['keys'] is string
        && incoming()['keys'].size() <= 20000
        && incoming()['updatedBy'] == request.auth.uid;
      allow list, delete: if false;
    }

    // Last Saira failure per user (AiDiagnostics.kt) so the maintainer can see
    // why a device fell back to the friendly safety-net message.
    match /aiDiagnostics/{docId} {
      allow get, list, delete: if false;
      allow create, update: if (
          (request.auth != null && request.auth.uid == docId)
          || docId.matches('^dev_[a-f0-9]{24}$')
        )
        && incoming().keys().hasOnly(['stage', 'errorClass', 'message', 'keyCount', 'signedIn', 'appVersion', 'updatedAt'])
        && incoming().stage is string && incoming().stage.size() <= 40
        && incoming().errorClass is string && incoming().errorClass.size() <= 120
        && incoming().message is string && incoming().message.size() <= 600
        && incoming().keyCount is int
        && incoming().signedIn is bool
        && incoming().appVersion is string && incoming().appVersion.size() <= 40
        && incoming().updatedAt == request.time;
    }

    match /settings/{appearance} {
      allow get: if isSignedIn() && appearance in ['sparkTheme', 'sparkMenu'];
      allow create, update: if appearance in ['sparkTheme', 'sparkMenu']
        && isSparkAdmin()
        && recentlyAuthenticated()
        && isValidSparkAppearance(appearance, incoming())
        && incoming().updatedBy == request.auth.uid;
      allow list, delete: if false;
    }
  }
}
