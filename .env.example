# Optional browser-only isolated test project: JSON web config from a separate Firebase project.
# Never include service-account keys; leave unset for the existing default project.
# VITE_CHATBOX_TEST_MODE=true
# VITE_CHATBOX_TEST_FIREBASE_CONFIG={"projectId":"...","apiKey":"...","authDomain":"...","messagingSenderId":"...","appId":"..."}
# Enable only after reviewing and deploying the Firestore security rules and testing with two accounts.
VITE_ENABLE_FIRESTORE_CHAT=false
# Test lab only: do not enable against live users; requires separately reviewed candidate call rules.
VITE_ENABLE_EXPERIMENTAL_CALLS=false
# Additional Android test-only gate; also requires a dedicated isolated debug APK.
VITE_ENABLE_EXPERIMENTAL_ANDROID_CALLS=false
# Optional browser-lab Google STUN; shares network IP with Google and may not
# connect through restrictive networks. Not a TURN relay; never put TURN keys here.
VITE_ENABLE_EXPERIMENTAL_STUN=false
# Blocking lab is incomplete and only for isolated emulator tests.
VITE_ENABLE_EXPERIMENTAL_BLOCKING=false
# Isolated message cooldown lab; client requires the matching review-only cooldown rules.
VITE_ENABLE_EXPERIMENTAL_MESSAGE_COOLDOWN=false
# Isolated request cooldown candidate requires chat AND message cooldown flags and matching rules.
VITE_ENABLE_EXPERIMENTAL_REQUEST_COOLDOWN=false
# These remain off until the backend, App Check and AI provider are securely configured and tested.
# Select firebase-ai for the experimental Firebase AI Logic free-tier path; functions requires a billed backend.
VITE_SAIRA_PROVIDER=firebase-ai
VITE_ENABLE_SAIRA_AI=false
# Spark admin is a separate experimental prototype with undeployed rules; keep it off until reviewed.
VITE_ENABLE_SPARK_ADMIN=false
VITE_ENABLE_ADMIN_BACKEND=false
VITE_APP_CHECK_SITE_KEY=

# Review-only admin source handover. Requires authorized Cloud Functions,
# App Check, private Drive permissions and separate archive publishing setup.
# Do not enable until those are configured and security-reviewed.
VITE_ENABLE_SOURCE_HANDOVER=false
# Android AI is restricted to the separate isolated debug call-lab package.
# Requires the test Firebase AI API and Play Integrity App Check; never use on production.
VITE_ENABLE_EXPERIMENTAL_ANDROID_AI=false
# Spark source QR is a separate isolated-test-only candidate, off by default.
# Requires reviewed rules and trusted server-side provisioning of a private link.
VITE_ENABLE_SPARK_SOURCE_HANDOVER=false
# Isolated Android-only AI interpretation for limited admin settings; opt-in.
# Requests sent to Gemini may be retained/used per the provider's free-tier terms.
VITE_ENABLE_EXPERIMENTAL_MULTILINGUAL_ADMIN=false

# Test-only manual clipboard handoff to Arena; no automated editing or deployment.
VITE_ENABLE_CODE_REQUEST_HANDOFF=false

# Test-only review of one public source file using Gemini; requires Android AI lab.
VITE_ENABLE_CODE_PROPOSAL_LAB=false
# VITE_CODE_PROPOSAL_REF=<full 40-character Git commit>
